{
  "name": "dsh-skill-menu-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "Left-sidebar panel that controls how skills appear in the / slash menu: display name, description, visibility and order, without changing the skills themselves.",
  "license": "MIT",
  "author": "YSJ-Q",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "harness",
    "skills",
    "slash-menu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YSJ-Q/dsh-skill-menu-studio.git"
  },
  "homepage": "https://github.com/YSJ-Q/dsh-skill-menu-studio#readme",
  "bugs": {
    "url": "https://github.com/YSJ-Q/dsh-skill-menu-studio/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
